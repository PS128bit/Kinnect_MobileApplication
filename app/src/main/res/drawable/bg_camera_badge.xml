<?xml version="1.0" encoding="utf-8"?>
<!--
    Small camera button on the profile picture:
    a white circle (the 3dp ring) with a grey circle on top, inset by 3dp.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/pill_grey" />
        </shape>
    </item>
</layer-list>
