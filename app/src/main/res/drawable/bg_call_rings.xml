<?xml version="1.0" encoding="utf-8"?>
<!--
    Two soft see-through rounded squares behind the caller's picture:
    the outer one (5% white) and, 12dp inside it, a brighter one (12% white).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="70dp" />
        </shape>
    </item>

    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="60dp" />
        </shape>
    </item>
</layer-list>
