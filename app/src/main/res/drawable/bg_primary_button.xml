<?xml version="1.0" encoding="utf-8"?>
<!-- Teal pill button: Log in, Create account, Post -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kinnect_teal" />
    <!-- A radius larger than half the height turns the rectangle into a pill -->
    <corners android:radius="100dp" />
</shape>