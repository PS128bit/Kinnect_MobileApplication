<?xml version="1.0" encoding="utf-8"?>
<!-- Story card shape (12dp corners). The card sets clipToOutline="true",
     so the photo and everything inside it are cut to these rounded corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pill_grey" />
    <corners android:radius="12dp" />
</shape>
