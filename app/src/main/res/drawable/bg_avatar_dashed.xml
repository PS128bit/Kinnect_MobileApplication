<?xml version="1.0" encoding="utf-8"?>
<!-- Profile-photo placeholder on Sign up: white circle with a dashed grey ring -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
    <stroke
        android:width="1.5dp"
        android:color="@color/dash_grey"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>