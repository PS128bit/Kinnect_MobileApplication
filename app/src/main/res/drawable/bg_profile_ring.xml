<?xml version="1.0" encoding="utf-8"?>
<!-- White circle with a 3dp teal outline: the ring around someone else's profile picture -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
    <stroke
        android:width="3dp"
        android:color="@color/kinnect_teal" />
</shape>
