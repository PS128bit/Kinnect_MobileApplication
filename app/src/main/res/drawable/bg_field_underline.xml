<?xml version="1.0" encoding="utf-8"?>
<!--
    Text box with only a thin grey line along the bottom (Edit profile fields).
    The shape has a 1dp border on all sides, but the top, left and right edges
    are pushed 2dp outside the view, so only the bottom line is visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</layer-list>
