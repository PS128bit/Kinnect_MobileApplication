<?xml version="1.0" encoding="utf-8"?>
<!--
    18 · Notifications
    Header and top tab bar stay fixed at the top; the content below scrolls (ScrollView).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".NotificationsActivity">

    <!--
        Header: screen title on the left, round Search and Chats buttons on the right.
        RelativeLayout lets the orange "3" badge overlap the Chats button.
    -->
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Screen title -->
        <TextView
            android:id="@+id/tv_notifications_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/tab_notifications"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Chats button: grey circle with the chat icon -->
        <ImageView
            android:id="@+id/iv_header_chats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_chats"
            android:padding="10dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/text_primary" />

        <!-- Unread chats badge, overlapping the Chats button's top-right corner -->
        <TextView
            android:id="@+id/tv_badge_chats"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignTop="@id/iv_header_chats"
            android:layout_alignEnd="@id/iv_header_chats"
            android:layout_marginTop="-5dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/badge_count_3"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Search button, 8dp to the left of Chats -->
        <ImageView
            android:id="@+id/iv_header_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/iv_header_chats"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <!--
        Top tab bar: 5 equal tabs (layout_weight="1" each).
        The active tab has a teal icon and a teal underline.
        Same ids on all 5 tab screens, so one piece of Kotlin can wire them all.
    -->
    <LinearLayout
        android:id="@+id/ll_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <!-- Home tab -->
        <RelativeLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_home">

            <ImageView
                android:id="@+id/iv_tab_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Friends tab -->
        <RelativeLayout
            android:id="@+id/tab_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_friends">

            <ImageView
                android:id="@+id/iv_tab_friends"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_friends"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Marketplace tab -->
        <RelativeLayout
            android:id="@+id/tab_marketplace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_marketplace">

            <ImageView
                android:id="@+id/iv_tab_marketplace"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_marketplace"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Notifications tab (active) -->
        <RelativeLayout
            android:id="@+id/tab_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_notifications">

            <ImageView
                android:id="@+id/iv_tab_notifications"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notifications"
                app:tint="@color/kinnect_teal" />

            <!-- Unread notifications badge, overlapping the bell's top-right corner -->
            <TextView
                android:id="@+id/tv_badge_notifications"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignTop="@id/iv_tab_notifications"
                android:layout_alignEnd="@id/iv_tab_notifications"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-7dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/badge_count_5"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Teal underline marks the active tab -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:background="@color/kinnect_teal" />
        </RelativeLayout>

        <!-- Menu tab -->
        <RelativeLayout
            android:id="@+id/tab_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_menu">

            <ImageView
                android:id="@+id/iv_tab_menu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Thin line under the tab bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Scrolling content -->
    <ScrollView
        android:id="@+id/sv_notifications_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_notif_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:text="@string/notif_new"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- "New" notifications sit on a light-teal band (unread) -->
            <LinearLayout
                android:id="@+id/ll_notif_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/teal_light"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Notification 1 -->
                <RelativeLayout
                    android:id="@+id/rl_notif_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!--
                        Avatar holder (66dp): 60dp avatar in the top-left corner and a small
                        icon badge in the bottom-right corner, so the badge overlaps the avatar.
                    -->
                    <RelativeLayout
                        android:id="@+id/rl_notif_avatar_1"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_alignParentStart="true">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/avatar_maroon"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_ak"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Badge: white circle (the ring) with a 3dp padding around a coloured circle -->
                        <RelativeLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_circle"
                            android:padding="3dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/love_red"
                                android:importantForAccessibility="no"
                                android:padding="6dp"
                                android:src="@drawable/ic_heart"
                                app:tint="@color/white" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <!-- "..." options on the right -->
                    <ImageView
                        android:id="@+id/iv_notif_more_1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="7dp"
                        android:contentDescription="@string/cd_more_options"
                        android:src="@drawable/ic_more"
                        app:tint="@color/text_secondary" />

                    <!-- Message (names in bold via <b> in strings.xml) and time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="24dp"
                        android:layout_toStartOf="@id/iv_notif_more_1"
                        android:layout_toEndOf="@id/rl_notif_avatar_1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/notif_aisha"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/time_5m"
                            android:textColor="@color/kinnect_teal"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Notification 2 -->
                <RelativeLayout
                    android:id="@+id/rl_notif_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!--
                        Avatar holder (66dp): 60dp avatar in the top-left corner and a small
                        icon badge in the bottom-right corner, so the badge overlaps the avatar.
                    -->
                    <RelativeLayout
                        android:id="@+id/rl_notif_avatar_2"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_alignParentStart="true">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/avatar_indigo"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_si"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Badge: white circle (the ring) with a 3dp padding around a coloured circle -->
                        <RelativeLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_circle"
                            android:padding="3dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/kinnect_teal"
                                android:importantForAccessibility="no"
                                android:padding="6dp"
                                android:src="@drawable/ic_person"
                                app:tint="@color/white" />
                        </RelativeLayout>
                    </RelativeLayout>

                    <!-- "..." options on the right -->
                    <ImageView
                        android:id="@+id/iv_notif_more_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="7dp"
                        android:contentDescription="@string/cd_more_options"
                        android:src="@drawable/ic_more"
                        app:tint="@color/text_secondary" />

                    <!-- Message (names in bold via <b> in strings.xml) and time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="24dp"
                        android:layout_toStartOf="@id/iv_notif_more_2"
                        android:layout_toEndOf="@id/rl_notif_avatar_2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/notif_sara"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/time_20m"
                            android:textColor="@color/kinnect_teal"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Confirm / Delete: two equal buttons (layout_weight="1") -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_notif_confirm_2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_small_button"
                                android:backgroundTint="@color/kinnect_teal"
                                android:padding="0dp"
                                android:text="@string/confirm"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btn_notif_delete_2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_small_button"
                                android:backgroundTint="@color/pill_grey"
                                android:padding="0dp"
                                android:text="@string/delete"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>