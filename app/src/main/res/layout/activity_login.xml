<?xml version="1.0" encoding="utf-8"?>
<!--
    02 · Log in
    ScrollView: The screen can scroll on small phones and in landscape.
    fillViewport="true" stretches the content to full height when it is shorter than the screen, so the layout_weight spacer can push "Create new account" to the bottom, as in the design.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Language picker: "English (UK)" with a small down arrow -->
        <LinearLayout
            android:id="@+id/ll_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english_uk"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_language_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/cd_change_language"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- App icon tile: white Kinnect logo on a teal rounded square -->
        <ImageView
            android:id="@+id/iv_login_logo"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_app_icon"
            android:contentDescription="@string/cd_kinnect_logo"
            android:padding="18dp"
            android:src="@drawable/ic_logo" />

        <!-- "RECENT LOGIN" section label -->
        <TextView
            android:id="@+id/tv_recent_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="37dp"
            android:letterSpacing="0.06"
            android:text="@string/recent_login"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
            Recent login card.
            RelativeLayout (Lecture 03) lets the "2" badge overlap the avatar's
            top-right corner: alignTop + alignEnd on the avatar, then negative
            margins push it slightly outside. Declared after the avatar, so it draws on top.
        -->
        <RelativeLayout
            android:id="@+id/rl_recent_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_outline"
            android:padding="13dp">

            <!-- Avatar: teal circle with initials -->
            <TextView
                android:id="@+id/tv_recent_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/kinnect_teal"
                android:gravity="center"
                android:text="@string/demo_user_initials"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Notification badge overlapping the avatar's top-right corner -->
            <TextView
                android:id="@+id/tv_recent_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignTop="@id/tv_recent_avatar"
                android:layout_alignEnd="@id/tv_recent_avatar"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-3dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/badge_count_2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- "..." options button on the right -->
            <ImageView
                android:id="@+id/iv_recent_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/cd_more_options"
                android:src="@drawable/ic_more"
                app:tint="@color/text_secondary" />

            <!-- Name and "Tap to log in", between the avatar and the "..." button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/iv_recent_more"
                android:layout_toEndOf="@id/tv_recent_avatar"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recent_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/demo_user_name"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_recent_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/tap_to_log_in"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Email / phone box: -->
        <LinearLayout
            android:id="@+id/ll_email_box"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <TextView
                android:id="@+id/tv_email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_email_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- background="@null" and padding="0dp" remove EditText's default underline and spacing so it fits neatly inside our rounded box -->
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autofillHints="emailAddress"
                android:background="@null"
                android:inputType="textEmailAddress"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/demo_email"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Password box: label + hidden password on the left, eye icon on the right -->
        <LinearLayout
            android:id="@+id/ll_password_box"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <!-- layout_weight="1" this column takes all spare width pushing the eye icon to the right edge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_password_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_password_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- inputType="textPassword" shows dots instead of letters -->
                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autofillHints="password"
                    android:background="@null"
                    android:inputType="textPassword"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/demo_password"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Show-password eye -->
            <ImageView
                android:id="@+id/iv_show_password"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_show_password"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Main "Log in" button:  -->
        <Button
            android:id="@+id/btn_log_in"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/log_in"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- "Forgot password?" link -->
        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="@string/forgot_password"
            android:textColor="@color/kinnect_teal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!--
            Spacer: height 0dp + layout_weight="1"  takes all leftover
            vertical space, pushing "Create new account" to the bottom on any
            screen size. minHeight keeps a small gap in landscape.
        -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- "Create new account": opens Sign up -->
        <Button
            android:id="@+id/btn_create_account"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_outline"
            android:text="@string/create_new_account"
            android:textColor="@color/kinnect_teal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Footer: small grey logo + "Kinnect · from SMD" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Same ic_logo as Splash-->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/cd_kinnect_logo"
                android:src="@drawable/ic_logo"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_login_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/footer_kinnect_from_smd"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>