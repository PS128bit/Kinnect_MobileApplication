<?xml version="1.0" encoding="utf-8"?>
<!--
    05 · Reaction picker
    Lina's post with a dim layer on top and the row of reaction faces above it.
    RelativeLayout stacks the three layers: post, dim layer, picker (later = on top).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ReactionPickerActivity">

    <!-- Lina's post (the screen behind the picker) -->
    <LinearLayout
        android:id="@+id/ll_post_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: back arrow and "Lina's post" -->
        <RelativeLayout
            android:id="@+id/rl_post_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            android:paddingStart="2dp">

            <ImageView
                android:id="@+id/iv_post_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/cd_back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/iv_post_back"
                android:text="@string/linas_post"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- The post and its first comment; scrolls if the screen is short (e.g. landscape) -->
        <ScrollView
            android:id="@+id/sv_post"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_cream">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- White post section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <!-- Post header: avatar, name + place, time + globe -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/avatar_purple"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_lm"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/post_author_line"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/post_time_2h"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginStart="3dp"
                                    android:contentDescription="@string/cd_public"
                                    android:src="@drawable/ic_globe"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/post_text_sunset"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <!-- One large photo -->
                    <ImageView
                        android:id="@+id/iv_post_detail_photo"
                        android:layout_width="match_parent"
                        android:layout_height="336dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/cd_post_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_post_1" />

                    <!-- Reactions summary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/react_like" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="-4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/react_love" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="-4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/react_haha" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:text="@string/post_reacted_by"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/count_86_comments"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/divider" />

                    <!-- Like (teal = you are reacting) / Comment / Share -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_like"
                                app:tint="@color/kinnect_teal" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/action_like"
                                android:textColor="@color/kinnect_teal"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chat"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/action_comment"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_share"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/action_share"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Grey band -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/feed_band" />

                <!-- First comment section (white) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/most_relevant"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/avatar_maroon"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_ak"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_bubble"
                            android:backgroundTint="@color/pill_grey"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="9dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/name_aisha_khan"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/comment_aisha_short"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!--
        Dim layer over the whole screen (30% black). Tapping it closes the picker.
        It is declared after the post, so it is drawn on top of it.
    -->
    <View
        android:id="@+id/v_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:contentDescription="@string/cd_close_reactions"
        android:focusable="true" />

    <!--
        Reaction picker, drawn on top of the dim layer, over the bottom of the photo.
        RelativeLayout lets the "Love" tooltip and the bigger Love face stick out above the white bar.
    -->
    <RelativeLayout
        android:id="@+id/rl_reaction_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="416dp">

        <!-- "Love" tooltip above the selected face -->
        <TextView
            android:id="@+id/tv_love_tooltip"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="62dp"
            android:background="@drawable/bg_tooltip"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="@string/reaction_love"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- White bar behind the faces; elevation draws its shadow -->
        <View
            android:id="@+id/v_reaction_bar"
            android:layout_width="315dp"
            android:layout_height="58dp"
            android:layout_alignParentStart="true"
            android:layout_below="@id/tv_love_tooltip"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_reaction_bar"
            android:elevation="6dp" />

        <!--
            The six faces, bottom-aligned to the bar. Small faces sit 11dp above the bar's bottom
            (centred in it); the selected Love face is bigger and raised, so it pokes out of the bar.
            Same elevation as the bar so the faces are drawn above it.
        -->
        <LinearLayout
            android:id="@+id/ll_reaction_faces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/v_reaction_bar"
            android:layout_alignBottom="@id/v_reaction_bar"
            android:elevation="6dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="13dp">

            <ImageView
                android:id="@+id/iv_react_like"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="11dp"
                android:contentDescription="@string/reaction_like"
                android:src="@drawable/react_like" />

            <ImageView
                android:id="@+id/iv_react_love"
                android:layout_width="49dp"
                android:layout_height="49dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="22dp"
                android:contentDescription="@string/reaction_love"
                android:src="@drawable/react_love" />

            <ImageView
                android:id="@+id/iv_react_haha"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="11dp"
                android:contentDescription="@string/reaction_haha"
                android:src="@drawable/react_haha" />

            <ImageView
                android:id="@+id/iv_react_wow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="11dp"
                android:contentDescription="@string/reaction_wow"
                android:src="@drawable/react_wow" />

            <ImageView
                android:id="@+id/iv_react_sad"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="11dp"
                android:contentDescription="@string/reaction_sad"
                android:src="@drawable/react_sad" />

            <ImageView
                android:id="@+id/iv_react_angry"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="11dp"
                android:contentDescription="@string/reaction_angry"
                android:src="@drawable/react_angry" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>