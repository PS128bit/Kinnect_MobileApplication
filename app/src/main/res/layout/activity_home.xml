<?xml version="1.0" encoding="utf-8"?>
<!--
    04 · Home feed
    Header and top tab bar stay fixed at the top; everything below them is inside a ScrollView so the feed scrolls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <!--
        Header: screen title on the left, round Search and Chats buttons on the right.
        RelativeLayout lets the orange "3" badge overlap the Chats button.
    -->
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- "kinnect" wordmark -->
        <TextView
            android:id="@+id/tv_home_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:letterSpacing="-0.02"
            android:text="@string/wordmark"
            android:textColor="@color/kinnect_teal"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Chats button: grey circle with the chat icon -->
        <ImageView
            android:id="@+id/iv_header_chats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_chats"
            android:padding="10dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/text_primary" />

        <!-- Unread chats badge, overlapping the Chats button's top-right corner -->
        <TextView
            android:id="@+id/tv_badge_chats"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignTop="@id/iv_header_chats"
            android:layout_alignEnd="@id/iv_header_chats"
            android:layout_marginTop="-5dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/badge_count_3"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Search button, 8dp to the left of Chats -->
        <ImageView
            android:id="@+id/iv_header_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/iv_header_chats"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <!--
        Top tab bar: 5 equal tabs (layout_weight="1" each).
        The active tab has a teal icon and a teal underline.
        Same ids on all 5 tab screens, so one piece of Kotlin can wire them all.
    -->
    <LinearLayout
        android:id="@+id/ll_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <!-- Home tab (active) -->
        <RelativeLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_home">

            <ImageView
                android:id="@+id/iv_tab_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                app:tint="@color/kinnect_teal" />

            <!-- Teal underline marks the active tab -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:background="@color/kinnect_teal" />
        </RelativeLayout>

        <!-- Friends tab -->
        <RelativeLayout
            android:id="@+id/tab_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_friends">

            <ImageView
                android:id="@+id/iv_tab_friends"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_friends"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Marketplace tab -->
        <RelativeLayout
            android:id="@+id/tab_marketplace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_marketplace">

            <ImageView
                android:id="@+id/iv_tab_marketplace"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_marketplace"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Notifications tab -->
        <RelativeLayout
            android:id="@+id/tab_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_notifications">

            <ImageView
                android:id="@+id/iv_tab_notifications"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notifications"
                app:tint="@color/text_primary" />

            <!-- Unread notifications badge, overlapping the bell's top-right corner -->
            <TextView
                android:id="@+id/tv_badge_notifications"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignTop="@id/iv_tab_notifications"
                android:layout_alignEnd="@id/iv_tab_notifications"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-7dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/badge_count_5"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Menu tab -->
        <RelativeLayout
            android:id="@+id/tab_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_menu">

            <ImageView
                android:id="@+id/iv_tab_menu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Thin line under the tab bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Scrolling feed -->
    <ScrollView
        android:id="@+id/sv_home_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Composer: your avatar, "What's on your mind?" pill, photo button -->
            <LinearLayout
                android:id="@+id/ll_composer"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Your avatar: opens your Profile -->
                <TextView
                    android:id="@+id/tv_composer_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/kinnect_teal"
                    android:contentDescription="@string/cd_your_profile"
                    android:gravity="center"
                    android:text="@string/demo_user_initials"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Pill: opens Create post. layout_weight="1" fills the middle. -->
                <TextView
                    android:id="@+id/tv_composer_prompt"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_composer_pill"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/composer_prompt"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <!-- Photo button: also opens Create post -->
                <ImageView
                    android:id="@+id/iv_composer_photo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_add_photo"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/kinnect_teal" />
            </LinearLayout>

            <!-- Grey band separating feed sections -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/feed_band" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>