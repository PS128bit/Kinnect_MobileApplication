<?xml version="1.0" encoding="utf-8"?>
<!--
    04 · Home feed
    Header and top tab bar stay fixed at the top; everything below them is inside a
    ScrollView so the feed scrolls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <!--
        Header: screen title on the left, round Search and Chats buttons on the right.
        RelativeLayout lets the orange "3" badge overlap the Chats button.
    -->
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- "kinnect" wordmark -->
        <TextView
            android:id="@+id/tv_home_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:letterSpacing="-0.02"
            android:text="@string/wordmark"
            android:textColor="@color/kinnect_teal"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Chats button: grey circle with the chat icon -->
        <ImageView
            android:id="@+id/iv_header_chats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_chats"
            android:padding="10dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/text_primary" />

        <!-- Unread chats badge, overlapping the Chats button's top-right corner -->
        <TextView
            android:id="@+id/tv_badge_chats"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignTop="@id/iv_header_chats"
            android:layout_alignEnd="@id/iv_header_chats"
            android:layout_marginTop="-5dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/badge_count_3"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Search button, 8dp to the left of Chats -->
        <ImageView
            android:id="@+id/iv_header_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/iv_header_chats"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/pill_grey"
            android:contentDescription="@string/cd_search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <!--
        Top tab bar: 5 equal tabs (layout_weight="1" each).
        The active tab has a teal icon and a teal underline.
        Same ids on all 5 tab screens, so one piece of Kotlin can wire them all.
    -->
    <LinearLayout
        android:id="@+id/ll_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <!-- Home tab (active) -->
        <RelativeLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_home">

            <ImageView
                android:id="@+id/iv_tab_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                app:tint="@color/kinnect_teal" />

            <!-- Teal underline marks the active tab -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:background="@color/kinnect_teal" />
        </RelativeLayout>

        <!-- Friends tab -->
        <RelativeLayout
            android:id="@+id/tab_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_friends">

            <ImageView
                android:id="@+id/iv_tab_friends"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_friends"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Marketplace tab -->
        <RelativeLayout
            android:id="@+id/tab_marketplace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_marketplace">

            <ImageView
                android:id="@+id/iv_tab_marketplace"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_marketplace"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Notifications tab -->
        <RelativeLayout
            android:id="@+id/tab_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_notifications">

            <ImageView
                android:id="@+id/iv_tab_notifications"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notifications"
                app:tint="@color/text_primary" />

            <!-- Unread notifications badge, overlapping the bell's top-right corner -->
            <TextView
                android:id="@+id/tv_badge_notifications"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignTop="@id/iv_tab_notifications"
                android:layout_alignEnd="@id/iv_tab_notifications"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-7dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/badge_count_5"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Menu tab -->
        <RelativeLayout
            android:id="@+id/tab_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/tab_menu">

            <ImageView
                android:id="@+id/iv_tab_menu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Thin line under the tab bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Scrolling feed -->
    <ScrollView
        android:id="@+id/sv_home_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Composer: your avatar, "What's on your mind?" pill, photo button -->
            <LinearLayout
                android:id="@+id/ll_composer"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Your avatar: opens your Profile -->
                <TextView
                    android:id="@+id/tv_composer_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/kinnect_teal"
                    android:contentDescription="@string/cd_your_profile"
                    android:gravity="center"
                    android:text="@string/demo_user_initials"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Pill: opens Create post. layout_weight="1" fills the middle. -->
                <TextView
                    android:id="@+id/tv_composer_prompt"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_composer_pill"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/composer_prompt"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <!-- Photo button: also opens Create post -->
                <ImageView
                    android:id="@+id/iv_composer_photo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_add_photo"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/kinnect_teal" />
            </LinearLayout>

            <!-- Grey band separating feed sections -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/feed_band" />

            <!--
                Stories row. HorizontalScrollView = the sideways version of ScrollView,
                so the cards can be swiped left and right.
                clipToPadding="false" lets cards scroll under the 16dp side padding.
            -->
            <HorizontalScrollView
                android:id="@+id/hsv_stories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!--
                        "Create story" card: opens the Camera.
                        clipToOutline="true" cuts the light-teal top to the rounded corners.
                    -->
                    <RelativeLayout
                        android:id="@+id/rl_create_story"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_create_story"
                        android:clipToOutline="true"
                        android:contentDescription="@string/create_story">

                        <!-- Light-teal top part of the card -->
                        <View
                            android:id="@+id/v_create_story_top"
                            android:layout_width="match_parent"
                            android:layout_height="118dp"
                            android:background="@color/teal_light" />

                        <!-- Your big avatar -->
                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/kinnect_teal"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/demo_user_initials"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- "+" button overlapping the line between the teal top and the white bottom:
                             118dp (line) - 15dp (half the button) = 103dp from the top -->
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="103dp"
                            android:background="@drawable/bg_plus_button"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="11dp"
                            android:text="@string/create_story"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Story card: name_omar_farooq -->
                    <RelativeLayout
                        android:id="@+id/rl_story_1"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_story_card"
                        android:clipToOutline="true"
                        android:contentDescription="@string/cd_story_1">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_story_1" />

                        <!-- Dark fade so the white name is readable -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_story_scrim" />

                        <!-- Avatar inside a teal ring (ring = container background, 4dp padding) -->
                        <RelativeLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_story_ring"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/avatar_green"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/initials_of"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginBottom="9dp"
                            android:maxLines="1"
                            android:text="@string/name_omar_farooq"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Story card: name_sara_iqbal -->
                    <RelativeLayout
                        android:id="@+id/rl_story_2"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_story_card"
                        android:clipToOutline="true"
                        android:contentDescription="@string/cd_story_2">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_story_2" />

                        <!-- Dark fade so the white name is readable -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_story_scrim" />

                        <!-- Avatar inside a teal ring (ring = container background, 4dp padding) -->
                        <RelativeLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_story_ring"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/avatar_indigo"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/initials_si"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginBottom="9dp"
                            android:maxLines="1"
                            android:text="@string/name_sara_iqbal"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Story card: name_hamza_ali -->
                    <RelativeLayout
                        android:id="@+id/rl_story_3"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_story_card"
                        android:clipToOutline="true"
                        android:contentDescription="@string/cd_story_3">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_story_3" />

                        <!-- Dark fade so the white name is readable -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_story_scrim" />

                        <!-- Avatar inside a teal ring (ring = container background, 4dp padding) -->
                        <RelativeLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_story_ring"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/avatar_brown"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/initials_ha"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginBottom="9dp"
                            android:maxLines="1"
                            android:text="@string/name_hamza_ali"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Grey band -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/feed_band" />

            <!-- ==================== Post: Lina Marsh ==================== -->

            <!-- Post header: avatar, name + place, time, "..." and close buttons -->
            <RelativeLayout
                android:id="@+id/rl_post_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tv_post_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/avatar_purple"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/initials_lm"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Close (hide post) on the far right -->
                <ImageView
                    android:id="@+id/iv_post_close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/cd_hide_post"
                    android:padding="2dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />

                <!-- "..." options, 18dp left of the close button -->
                <ImageView
                    android:id="@+id/iv_post_more"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="18dp"
                    android:layout_toStartOf="@id/iv_post_close"
                    android:contentDescription="@string/cd_more_options"
                    android:src="@drawable/ic_more"
                    app:tint="@color/text_secondary" />

                <!-- Name + place, and time + globe, between the avatar and the buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/iv_post_more"
                    android:layout_toEndOf="@id/tv_post_avatar"
                    android:orientation="vertical">

                    <!-- <b> tags inside strings.xml make only the names bold -->
                    <TextView
                        android:id="@+id/tv_post_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/post_author_line"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_post_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/post_time_2h"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="3dp"
                            android:contentDescription="@string/cd_public"
                            android:src="@drawable/ic_globe"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Post text -->
            <TextView
                android:id="@+id/tv_post_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/post_text_sunset"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!--
                Photo grid: one tall photo on the left, two stacked on the right.
                Columns share the width equally (layout_weight="1"); 3dp white gaps between photos.
            -->
            <LinearLayout
                android:id="@+id/ll_post_photos"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_post_photo_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_post_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_post_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_post_photo_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_post_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_post_2" />

                    <!-- Last tile: photo, darkened, with "+4" (4 more photos) on top -->
                    <RelativeLayout
                        android:id="@+id/rl_post_more_photos"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="3dp"
                        android:layout_weight="1">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_post_photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_post_4" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/photo_dim" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/more_photos_4"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Reactions summary: 3 overlapping reaction badges + counts -->
            <LinearLayout
                android:id="@+id/ll_post_reactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Negative marginStart makes each badge overlap the previous one;
                     later children are drawn on top -->
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/react_like" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="-4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/react_love" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="-4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/react_haha" />

                <!-- layout_weight="1" pushes the comment/share counts to the right -->
                <TextView
                    android:id="@+id/tv_post_reaction_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/post_reacted_by"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_post_counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/post_comment_share_counts"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Thin divider above the action buttons -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@color/divider" />

            <!-- Like / Comment / Share: three equal buttons (layout_weight="1") -->
            <LinearLayout
                android:id="@+id/ll_post_actions"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">

                <!-- Like: tap = like, opens the Reaction picker -->
                <LinearLayout
                    android:id="@+id/ll_action_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_like"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/action_like"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Comment: opens Comments -->
                <LinearLayout
                    android:id="@+id/ll_action_comment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/action_comment"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Share -->
                <LinearLayout
                    android:id="@+id/ll_action_share"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_share"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/action_share"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grey band at the end of the feed -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/feed_band" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>