<?xml version="1.0" encoding="utf-8"?>
<!--
    16 · Edit profile
    Top bar fixed (Cancel / Save); pictures and the form scroll underneath.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".EditProfileActivity">

    <!-- Top bar: Cancel on the left, title in the middle, Save on the right -->
    <RelativeLayout
        android:id="@+id/rl_edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_edit_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/cancel"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/profile_edit"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_edit_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/edit_save"
            android:textColor="@color/kinnect_teal"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Form scrolls under the top bar (ScrollView) -->
    <ScrollView
        android:id="@+id/sv_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- "Profile picture" heading with a teal "Edit" link on the same baseline -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tv_picture_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/edit_picture"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_picture_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/tv_picture_title"
                    android:layout_alignParentEnd="true"
                    android:text="@string/edit_link"
                    android:textColor="@color/kinnect_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_edit_avatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/kinnect_teal"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/demo_user_initials"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- "Cover photo" heading with a teal "Edit" link on the same baseline -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv_cover_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/edit_cover"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cover_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/tv_cover_title"
                    android:layout_alignParentEnd="true"
                    android:text="@string/edit_link"
                    android:textColor="@color/kinnect_teal"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!--
                Cover preview: rounded box (clipToOutline cuts the picture to the round corners)
                with a white camera button in the bottom-right corner.
            -->
            <RelativeLayout
                android:id="@+id/rl_edit_cover"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_photo_rounded"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_cover_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_cover_me" />

                <ImageView
                    android:id="@+id/iv_edit_cover_camera"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white"
                    android:contentDescription="@string/cd_change_cover"
                    android:padding="10dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_primary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/divider" />

            <!-- Name row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_name"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="@string/demo_user_name"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Username row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_username"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_username"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="@string/edit_username_value"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Website row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_website"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_website"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:hint="@string/edit_label_website"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Bio row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_bio"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_bio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="@string/edit_bio_value"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_professional_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/edit_professional_mode"
                android:textColor="@color/kinnect_teal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/edit_private_info"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Email row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_email"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="@string/edit_email_value"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Phone row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_phone"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_edit_phone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="@string/edit_phone_value"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Gender row: 104dp label, then the value with a line under it (weight 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/edit_label_gender"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_edit_gender"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field_underline"
                    android:gravity="center_vertical"
                    android:text="@string/edit_gender_value"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>