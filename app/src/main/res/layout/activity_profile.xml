<?xml version="1.0" encoding="utf-8"?>
<!--
    15 · Profile (your own profile)
    Top bar fixed; cover, picture, buttons, Details and Friends scroll underneath.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ProfileActivity">

    <!-- Top bar: back arrow, name, search -->
    <RelativeLayout
        android:id="@+id/rl_profile_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/iv_profile_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_profile_top_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@id/iv_profile_back"
            android:text="@string/demo_user_name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_profile_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/cd_search"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Everything under the top bar scrolls (ScrollView) -->
    <ScrollView
        android:id="@+id/sv_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!--
                Cover + profile picture. RelativeLayout lets the round picture
                hang 70dp below the cover, and the camera buttons sit on top.
            -->
            <RelativeLayout
                android:id="@+id/rl_profile_cover_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_profile_cover"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:contentDescription="@string/cd_cover_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_cover_me" />

                <!-- Change cover photo: grey circle in the cover's bottom-right corner -->
                <ImageView
                    android:id="@+id/iv_profile_cover_camera"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignEnd="@id/iv_profile_cover"
                    android:layout_alignBottom="@id/iv_profile_cover"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/pill_grey"
                    android:contentDescription="@string/cd_change_cover"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_primary" />

                <!-- Profile picture: white circle (the 5dp ring) with the teal "JW" circle inside -->
                <RelativeLayout
                    android:id="@+id/rl_profile_avatar"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="116dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/white">

                    <TextView
                        android:id="@+id/tv_profile_avatar"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/kinnect_teal"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/demo_user_initials"
                        android:textColor="@color/white"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <!-- Change profile picture: small grey circle with a white ring -->
                    <ImageView
                        android:id="@+id/iv_profile_avatar_camera"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="108dp"
                        android:layout_marginTop="106dp"
                        android:background="@drawable/bg_camera_badge"
                        android:contentDescription="@string/cd_change_picture"
                        android:padding="11dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/text_primary" />
                </RelativeLayout>
            </RelativeLayout>

            <!-- Everything below the cover has 16dp side margins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/demo_user_name"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- "834" bold and dark, "friends" grey (see profile_friend_count in strings.xml) -->
                <TextView
                    android:id="@+id/tv_profile_friend_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/profile_friend_count"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_profile_bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/profile_bio"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <!-- Buttons: Add to story and Edit profile share the width (weight 1 each), More is 44dp -->
                <LinearLayout
                    android:id="@+id/ll_profile_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <!-- Add to story: teal, white plus icon + text -->
                    <LinearLayout
                        android:id="@+id/ll_add_to_story"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_small_button"
                        android:backgroundTint="@color/kinnect_teal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/profile_add_to_story"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Edit profile: grey, pencil icon + text -->
                    <LinearLayout
                        android:id="@+id/ll_edit_profile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_small_button"
                        android:backgroundTint="@color/pill_grey"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/profile_edit"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- More: grey square with three dots -->
                    <ImageView
                        android:id="@+id/iv_profile_more"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_small_button"
                        android:backgroundTint="@color/pill_grey"
                        android:contentDescription="@string/cd_more_options"
                        android:padding="10dp"
                        android:src="@drawable/ic_more"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Section tabs: Posts (selected), Photos, Videos, Groups -->
                <LinearLayout
                    android:id="@+id/ll_profile_sections"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Selected section: light teal pill with teal text -->
                    <TextView
                        android:id="@+id/tv_section_posts"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/teal_light"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/filter_posts"
                        android:textColor="@color/kinnect_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_section_photos"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/profile_section_photos"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_section_videos"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/profile_section_videos"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_section_groups"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/filter_groups"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/profile_details"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Details: icon + text rows, 32dp each -->
                <LinearLayout
                    android:id="@+id/ll_detail_1"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_work"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/profile_work"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_detail_2"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_school"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/profile_studied"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_detail_3"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/profile_lives"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_detail_4"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/profile_joined"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Friends heading with "Find friends" on the right (same baseline) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tv_profile_friends_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/tab_friends"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_find_friends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@id/tv_profile_friends_title"
                        android:layout_alignParentEnd="true"
                        android:text="@string/profile_find_friends"
                        android:textColor="@color/kinnect_teal"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_friends_plain"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Three friend tiles, equal width (weight 1 each) -->
                <LinearLayout
                    android:id="@+id/ll_profile_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <!-- Friend 1 -->
                    <LinearLayout
                        android:id="@+id/ll_friend_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:background="@drawable/bg_rounded_square"
                            android:backgroundTint="@color/avatar_purple"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_lm"
                            android:textColor="@color/white"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/name_lina_marsh"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Friend 2 -->
                    <LinearLayout
                        android:id="@+id/ll_friend_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:background="@drawable/bg_rounded_square"
                            android:backgroundTint="@color/avatar_maroon"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_ak"
                            android:textColor="@color/white"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/name_aisha_khan"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Friend 3 -->
                    <LinearLayout
                        android:id="@+id/ll_friend_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:background="@drawable/bg_rounded_square"
                            android:backgroundTint="@color/avatar_green"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/initials_of"
                            android:textColor="@color/white"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/name_omar_farooq"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_see_all_friends"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_small_button"
                    android:backgroundTint="@color/pill_grey"
                    android:padding="0dp"
                    android:text="@string/profile_see_all_friends"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>