                    <!-- Teal frame: shows on the photo that is in the big preview -->
                    <View
                        android:id="@+id/v_pick_frame_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_selected_frame"
                        android:visibility="gone" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_select_ring" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_pick_4"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/iv_pick_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_other_photo"
                        android:scaleType="centerCrop"
