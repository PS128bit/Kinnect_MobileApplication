                        android:scaleType="centerCrop"
                        android:src="@drawable/art_photo_night" />

                    <!-- Teal frame: shows on the photo that is in the big preview -->
                    <View
                        android:id="@+id/v_pick_frame_7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_selected_frame"
                        android:visibility="gone" />

                    <!-- Video: length in the bottom-right corner -->
                    <TextView
                        android:id="@+id/tv_pick_duration_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="7dp"
                        android:text="@string/picker_video_length"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_pick_8"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/iv_pick_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_other_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_photo_sea" />

                    <!-- Teal frame: shows on the photo that is in the big preview -->
                    <View
                        android:id="@+id/v_pick_frame_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_selected_frame"
                        android:visibility="gone" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_select_ring" />
                </RelativeLayout>
            </LinearLayout>
            <!-- Row 3: 4 square photos, equal width (weight 1 each), 2dp gaps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/rl_pick_9"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/iv_pick_9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_other_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_photo_dusk" />

                    <!-- Teal frame: shows on the photo that is in the big preview -->
                    <View
                        android:id="@+id/v_pick_frame_9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
