<?xml version="1.0" encoding="utf-8"?>
<!--
    LANDSCAPE version (res/layout-land): same screen, but the sticker sits higher (150dp) so it stays visible.
    10 · Story editor
    Dark screen: the story picture with tools and a sticker on top, share options at the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_black"
    android:orientation="vertical"
    tools:context=".StoryEditorActivity">

    <!--
        Story picture: rounded box filling the space above the bottom bar (layout_weight="1").
        Close and the tool buttons sit on top; the sticker is tilted with android:rotation.
    -->
    <RelativeLayout
        android:id="@+id/rl_editor_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_camera_view"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_editor_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/art_camera_view" />

        <ImageView
            android:id="@+id/iv_editor_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/photo_dim"
            android:contentDescription="@string/cd_close"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <!-- Tools: tag people, text, stickers, music, effects -->
        <LinearLayout
            android:id="@+id/ll_editor_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_editor_tag"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/photo_dim"
                android:contentDescription="@string/create_tag_people"
                android:padding="11dp"
                android:src="@drawable/ic_person_add"
                app:tint="@color/white" />

            <!-- Text tool: "Aa" in a circle -->
            <TextView
                android:id="@+id/tv_editor_text"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/photo_dim"
                android:gravity="center"
                android:text="@string/create_swatch_plain"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_editor_sticker"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/photo_dim"
                android:contentDescription="@string/cd_emoji"
                android:padding="10dp"
                android:src="@drawable/ic_emoji"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/iv_editor_music"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/photo_dim"
                android:contentDescription="@string/cd_music"
                android:padding="11dp"
                android:src="@drawable/ic_music"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/iv_editor_effects"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/photo_dim"
                android:contentDescription="@string/cd_effects"
                android:padding="11dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- "Saturday plans" sticker: orange rounded box, tilted 3 degrees -->
        <TextView
            android:id="@+id/tv_editor_sticker"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="150dp"
            android:background="@drawable/bg_sticker"
            android:backgroundTint="@color/accent_orange"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:rotation="3"
            android:text="@string/editor_sticker"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!--
        Bottom bar: "Your story" and "Close friends" share the width (weight 1 each),
        then the round teal Share button.
    -->
    <LinearLayout
        android:id="@+id/ll_editor_share_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/ll_share_your_story"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/story_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/kinnect_teal"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/demo_user_initials"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:text="@string/editor_your_story"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_share_close_friends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/story_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/online_green"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:text="@string/editor_close_friends"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_editor_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/kinnect_teal"
            android:contentDescription="@string/cd_share_story"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/white" />
    </LinearLayout>

</LinearLayout>
